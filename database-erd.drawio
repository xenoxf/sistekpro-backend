  <diagram name="ERD Base de Datos" id="erd-1">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Nota actualización -->
        <mxCell id="nota-2026-09-11" value="&lt;b&gt;Actualizado 2026-09-11&lt;/b&gt;&lt;br/&gt;• FichaTécnica ↔ Cliente 1:N via &lt;b&gt;ficha_tecnica.id_cliente UUID NULL FK → clientes.id_cliente ON DELETE SET NULL&lt;/b&gt;&lt;br/&gt;• GET /clientes ahora soporta &lt;b&gt;?search=&lt;/b&gt; (LIKE nombre/apellido/correo/telefono) para buscador del form&lt;br/&gt;• Form Ficha: seleccionar cliente existente (bloquea teléfono/dir/correo), &lt;b&gt;+ Nuevo cliente&lt;/b&gt; inline (form completo), o ficha huérfana con nombre manual&lt;br/&gt;• From Clientes: &lt;b&gt;Crear ficha para este cliente&lt;/b&gt; pre-selecciona cliente en FichasSection (evento + localStorage)&lt;br/&gt;• Fix: CreateFichaTecnicaDto Transform ''→undefined para id_cliente/tipoEquipo/fechas evita 'property tipoEquipo should not exist'&lt;br/&gt;&lt;i&gt;Ficha huérfana permitida; si vinculada, teléfono/dirección/correo vienen del cliente (bloqueados).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=1;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <geometry as="geometry" x="20" y="360" width="360" height="110" />
        </mxCell>
        <!-- Departamentos -->
        <mxCell id="departamentos" value="&lt;b&gt;departamentos&lt;/b&gt;&lt;br/&gt;&lt;table border='1' cellpadding='2' cellspacing='0' width='100%'&gt;&lt;tr&gt;&lt;td&gt;PK &lt;b&gt;id_departamento&lt;/b&gt; UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;nombre_departamento VARCHAR(100) UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;descripcion TEXT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;createdAt DATETIME(6)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;updatedAt DATETIME(6)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1">
          <geometry as="geometry" x="20" y="20" width="180" height="110" />
        </mxCell>
        <!-- Users -->
        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;br/&gt;&lt;table border='1' cellpadding='2' cellspacing='0' width='100%'&gt;&lt;tr&gt;&lt;td&gt;PK &lt;b&gt;id&lt;/b&gt; UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;name VARCHAR UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;password VARCHAR (select:false)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;role ENUM(admin,gerente,mantenimiento)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;FK &lt;i&gt;departamentoId&lt;/i&gt; UUID NULL → departamentos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;createdAt DATETIME(6)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;updatedAt DATETIME(6)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1">
          <geometry as="geometry" x="20" y="145" width="180" height="150" />
        </mxCell>
        <!-- Clientes -->
        <mxCell id="clientes" value="&lt;b&gt;clientes&lt;/b&gt;&lt;br/&gt;&lt;table border='1' cellpadding='2' cellspacing='0' width='100%'&gt;&lt;tr&gt;&lt;td style='background:#E8F5E9;'&gt;PK &lt;b&gt;id_cliente&lt;/b&gt; UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;nombre_cliente VARCHAR(80)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;apellido_cliente VARCHAR(80)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;correo_cliente VARCHAR(120) NULL UNIQUE* &lt;i&gt;(validado 409)&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;telefono VARCHAR(30) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dir VARCHAR(150) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tipo_cliente VARCHAR(50) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;createdAt DATETIME(6)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;updatedAt DATETIME(6)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;color:#2E7D32;'&gt;↗ 1:N fichasTecnicas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1">
          <geometry as="geometry" x="230" y="20" width="190" height="200" />
