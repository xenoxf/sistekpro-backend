        <!-- Ficha Tecnica - CORREGIDA -->
        <mxCell id="ficha_tecnica" value="&lt;b&gt;ficha_tecnica&lt;/b&gt; &lt;i style='color:#2E7D32;font-size:10px;'&gt;✔ vinculado 2026-09-11&lt;/i&gt;&lt;br/&gt;&lt;table border='1' cellpadding='2' cellspacing='0' width='100%'&gt;&lt;tr&gt;&lt;td&gt;PK &lt;b&gt;id&lt;/b&gt; UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#E8F5E9;'&gt;FK &lt;b&gt;id_cliente&lt;/b&gt; UUID NULL → clientes.id_cliente &lt;b&gt;ON DELETE SET NULL&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;nombreCliente VARCHAR (3-100) &lt;i&gt;NOT NULL&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;telefonoCliente VARCHAR(30) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;direccionCliente VARCHAR NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;correoCliente VARCHAR NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;servicio VARCHAR NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tipoEquipo ENUM(cpu,portatil,escritorio,server,todo_en_uno) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;nombreResponsable VARCHAR NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marcaEquipo VARCHAR NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;modeloEquipo VARCHAR NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;referencia VARCHAR NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tiempoGarantiaMeses INT NULL (0-240)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;fechaAdquisicion DATETIME NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tipoMonitor VARCHAR NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;serialEquipo VARCHAR UNIQUE NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tamanoPantallaPulgadas FLOAT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;procesadorMarca VARCHAR NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;procesadorModelo VARCHAR NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;procesadorBits VARCHAR(10) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;nucleosCpu INT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;velocidadProcesador VARCHAR(50) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;memoriaRamGb INT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;cantidadDiscosDuros INT DEFAULT 1 NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tecnologiaDisco1 VARCHAR(30) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;capacidadDisco1Gb INT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tecnologiaDisco2 VARCHAR(30) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;capacidadDisco2Gb INT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;lectorDvdCd BOOLEAN DEFAULT false&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tarjetaVideoIntegrada BOOLEAN DEFAULT false&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tarjetaVideoIndependiente BOOLEAN DEFAULT false&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;conectoresVga INT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;puertosHdmi INT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;puertosUsb INT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;puertosPci INT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;puertosPciExpress INT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tarjetaEthernet BOOLEAN DEFAULT false&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tarjetaRedInalambrica BOOLEAN DEFAULT false&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marcaMouse VARCHAR NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;serialMouse VARCHAR NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tipoConectorMouse VARCHAR(30) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;observaciones TEXT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;fechaRealizacion DATETIME NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;createdAt DATETIME(6)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;updatedAt DATETIME(6)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1">
