          <geometry as="geometry" x="450" y="20" width="210" height="200" />
        </mxCell>
        <!-- Seguimiento Eventos -->
        <mxCell id="seguimiento_eventos" value="&lt;b&gt;seguimiento_eventos&lt;/b&gt;&lt;br/&gt;&lt;table border='1' cellpadding='2' cellspacing='0' width='100%'&gt;&lt;tr&gt;&lt;td&gt;PK &lt;b&gt;id&lt;/b&gt; UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;FK &lt;i&gt;ordenId&lt;/i&gt; UUID → ordenes_servicio (CASCADE)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;titulo VARCHAR(150)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;descripcion TEXT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;createdAt DATETIME(6) &lt;i&gt;(Index orden+createdAt)&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1">
          <geometry as="geometry" x="450" y="235" width="210" height="115" />
