        <mxCell id="legend_001" value="&lt;b&gt;Leyenda — Símbolos&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;PK&lt;/b&gt; = Primary Key &amp;nbsp;|&amp;nbsp; &lt;b&gt;FK&lt;/b&gt; = Foreign Key &amp;nbsp;|&amp;nbsp; &lt;b&gt;UQ&lt;/b&gt; = Unique &amp;nbsp;|&amp;nbsp; &lt;b&gt;IDX&lt;/b&gt; = Índice&lt;br/&gt;• &lt;b&gt;NULL&lt;/b&gt; = nullable &amp;nbsp;|&amp;nbsp; &lt;b&gt;NN&lt;/b&gt; = NOT NULL &amp;nbsp;|&amp;nbsp; &lt;b&gt;DEFAULT&lt;/b&gt; = valor por defecto&lt;br/&gt;• &lt;b&gt;Conexión ER&lt;/b&gt;: &amp;nbsp; &lt;b&gt;1&lt;/b&gt; (ERone) → &lt;b&gt;N&lt;/b&gt; (ERmany / ERzeroToMany)&lt;br/&gt;• Línea &lt;b&gt;continua negra&lt;/b&gt; = relación real definida en TypeORM&lt;br/&gt;• &lt;b&gt;ON DELETE&lt;/b&gt; indica comportamiento (SET NULL, RESTRICT, CASCADE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacing=8;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1470" width="600" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="legend_002" value="&lt;b&gt;Enums &amp;amp; Tipos&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;ROLE&lt;/b&gt;: mantenimiento, admin, gerente, marketing (default: mantenimiento)&lt;br/&gt;• &lt;b&gt;TIPO_EQUIPO&lt;/b&gt;: cpu, portatil, escritorio, server, todo_en_uno&lt;br/&gt;• &lt;b&gt;ORDEN_ESTADO&lt;/b&gt;: recibido (default), diagnostico, pendiente_de_autorizacion, en_mantenimiento, en_pruebas, listo, entregado, cancelado&lt;br/&gt;• &lt;b&gt;Tipos comunes&lt;/b&gt;: uuid, varchar(N), text, int, float, boolean, datetime, datetime(6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacing=8;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="1470" width="650" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="legend_003" value="&lt;b&gt;Notas del modelo&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;MySQL&lt;/b&gt; | TypeORM &lt;b&gt;synchronize:true&lt;/b&gt; &amp;amp; autoLoadEntities:true (sin migraciones)&lt;br/&gt;• &lt;b&gt;Junction&lt;/b&gt; “ordenes_servicio_ficha_tecnica”: tabla auto-generada por @JoinTable() (ManyToMany). Contiene 2 FK compuestas PK.&lt;br/&gt;• &lt;b&gt;Colores&lt;/b&gt;: &lt;span style=&quot;background:#FFF2CC&quot;&gt;&amp;nbsp;Org&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#DAE8FC&quot;&gt;&amp;nbsp;Usuarios&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;Cliente/Ficha&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#FFE6CC&quot;&gt;&amp;nbsp;Órdenes&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#F8CECC&quot;&gt;&amp;nbsp;Seguimiento&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;Aislada&amp;nbsp;&lt;/span&gt;&lt;br/&gt;• &lt;b&gt;leads&lt;/b&gt; es tabla aislada sin FK (no tiene relaciones)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacing=8;spacingTop=8;fontSize=11;" vertex="1" parent="1">
